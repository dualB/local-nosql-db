{
  "name": "local-nosql-db",
  "version": "1.0.0",
  "description": "A lightweight local NoSQL database inspired by MongoDB, persisted in JSON files.",
  "keywords": [
    "local",
    "database",
    "nosql",
    "json",
    "storage",
    "mongodb-like"
  ],
  "author": "Claude Bouchard",
  "license": "ISC",

  "type": "commonjs",

  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",

  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },

  "files": [
    "dist"
  ],

  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist"
  },

  "repository": {
    "type": "git",
    "url": "git+https://github.com/dualB/local-nosql-db.git"
  },

  "engines": {
    "node": ">=18"
  },

  "dependencies": {
    "bson": "^6.10.3"
  },

  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  }
}